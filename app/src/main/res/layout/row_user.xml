<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingVertical="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/rowImage"
        android:layout_width="@dimen/size_avatar"
        android:layout_height="@dimen/size_avatar"
        android:layout_marginEnd="12dp"
        android:background="?attr/colorSurfaceContainer"
        android:contentDescription="@string/cd_profile_photo"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/App.Text.Title" />

        <TextView
            android:id="@+id/rowPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/App.Text.Secondary" />
    </LinearLayout>

    <Button
        android:id="@+id/btnEdit"
        style="@style/App.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/action_edit" />

    <Button
        android:id="@+id/btnDelete"
        style="@style/App.Button.Text.Destructive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xs"
        android:text="@string/action_delete" />
</LinearLayout>
