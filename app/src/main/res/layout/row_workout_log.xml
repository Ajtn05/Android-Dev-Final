<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingVertical="12dp"
    android:background="?android:attr/selectableItemBackground">

    <TextView
        android:id="@+id/rowLogRoutine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/App.Text.Title" />

    <TextView
        android:id="@+id/rowLogDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/App.Text.Body" />

    <TextView
        android:id="@+id/rowLogVolume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/App.Text.Secondary" />

    <TextView
        android:id="@+id/rowLogNotes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/App.Text.Caption"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
